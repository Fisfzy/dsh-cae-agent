{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-tools": ["node_modules/@deepseek-ai/dsh-tools/lib/types/index.d.ts"],
      "@deepseek-ai/cordis": ["node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-attachment": ["node_modules/@deepseek-ai/dsh-attachment/lib/types/index.d.ts"],
      "@deepseek-ai/schemastery": ["node_modules/@deepseek-ai/schemastery/lib/types/index.d.ts"]
    }
  },
  "include": ["src"]
}
