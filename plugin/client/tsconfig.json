{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "dsh-better-sidebar": ["../node_modules/dsh-better-sidebar/lib/types/index.d.ts"],
      "@deepseek-ai/cordis": ["../node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"]
    }
  },
  "include": ["src"]
}
